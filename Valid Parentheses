class Solution {
public:
    bool isValid(string s) {
        string st = "";
        for (int i = 0; i < s.length(); i++) {
            if (s[i] == '(' || s[i] == '[' || s[i] == '{') {
                st += s[i];
            }
            else {
                if (st.length() == 0) {
                    return false;
                }
                char x = st[st.length() - 1];
                if (s[i] == ')' && x == '(') {
                    st.pop_back();
                }
                else if (s[i] == ']' && x == '[') {
                    st.pop_back();
                }
                else if (s[i] == '}' && x == '{') {
                    st.pop_back();
                }
                else {
                    return false;
                }
            }
        }
        return st.length() == 0;
    }
};
