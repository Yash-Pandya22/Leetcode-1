class Solution {
public:
    string convert(string s, int numRows) {
        if (numRows == 1) {
            return s;
        }
        string rows[1000];
        int row = 0;
        bool down = true;
        for (int i = 0; i < s.length(); i++) {
            rows[row] = rows[row] + s[i];
            if (row == numRows - 1) {
                down = false;
            }
            if (row == 0) {
                down = true;
            }
            if (down) {
                row++;
            }
            else {
                row--;
            }
        }
        string result = "";
        for (int i = 0; i < numRows; i++) {
            result = result + rows[i];
        }
        return result;
    }
};
